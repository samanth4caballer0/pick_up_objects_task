digraph pastafarianism {
ordering=out;
graph [fontname="times-roman"];
node [fontname="times-roman"];
edge [fontname="times-roman"];
Sequence [fillcolor=orange, fontcolor=black, fontsize=9, label="Ⓜ Sequence", shape=box, style=filled];
done [fillcolor=gray, fontcolor=black, fontsize=9, label=done, shape=ellipse, style=filled];
Sequence -> done;
find_pickup_spot [fillcolor=gray, fontcolor=black, fontsize=9, label=find_pickup_spot, shape=ellipse, style=filled];
Sequence -> find_pickup_spot;
move_to_pickup [fillcolor=gray, fontcolor=black, fontsize=9, label=move_to_pickup, shape=ellipse, style=filled];
Sequence -> move_to_pickup;
turn_to_ball [fillcolor=gray, fontcolor=black, fontsize=9, label=turn_to_ball, shape=ellipse, style=filled];
Sequence -> turn_to_ball;
check_object [fillcolor=gray, fontcolor=black, fontsize=9, label=check_object, shape=ellipse, style=filled];
Sequence -> check_object;
get_object [fillcolor=gray, fontcolor=black, fontsize=9, label=get_object, shape=ellipse, style=filled];
Sequence -> get_object;
find_drop_spot [fillcolor=gray, fontcolor=black, fontsize=9, label=find_drop_spot, shape=ellipse, style=filled];
Sequence -> find_drop_spot;
move_to_drop [fillcolor=gray, fontcolor=black, fontsize=9, label=move_to_drop, shape=ellipse, style=filled];
Sequence -> move_to_drop;
let_object [fillcolor=gray, fontcolor=black, fontsize=9, label=let_object, shape=ellipse, style=filled];
Sequence -> let_object;
}
